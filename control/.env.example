# The Control Panel's own database (a separate Supabase project, or local Postgres).
DATABASE_URL="postgresql://postgres:gym@localhost:5433/gym_control"
DIRECT_URL="postgresql://postgres:gym@localhost:5433/gym_control"

# 32+ random characters. Signs logins and encrypts each cluster's API key.
# Never change it after clusters are added, or their keys can no longer be read.
CONTROL_SECRET=""

# First admin. Used to create the account on the first sign-in only.
CONTROL_ADMIN_EMAIL="you@example.com"
CONTROL_ADMIN_PASSWORD=""
