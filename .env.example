# Database (Supabase: use the pooled URL for DATABASE_URL and the direct one for DIRECT_URL)
DATABASE_URL="postgresql://postgres:gym@localhost:5433/gym"
DIRECT_URL="postgresql://postgres:gym@localhost:5433/gym"

# Sign-in. SESSION_SECRET: any random text, 32+ characters.
SESSION_SECRET=""
# The platform admin (you) signs in at /signin with these to create gyms.
SUPERADMIN_LOGIN="admin"
SUPERADMIN_PASSWORD=""

# WhatsApp sender (worker/) and the timer that queues automatic messages.
# The same WHATSAPP_WORKER_KEY and CRON_SECRET must be set on the worker.
WHATSAPP_WORKER_URL="http://localhost:3200"
WHATSAPP_WORKER_KEY=""
CRON_SECRET=""

# Optional: invoice emails through Resend (resend.com). EMAIL_FROM must be an
# address on a domain you have verified there.
# RESEND_API_KEY=""
# EMAIL_FROM="billing@yourdomain.com"

# Control Panel access (control/): long random text, also entered in the Control Panel
# PLATFORM_API_KEY=""

# Optional
# ALLOW_SIGNUP="false"   (stop gyms from signing themselves up at /signup)
# APP_URL="https://yourapp.example.com"
# APP_TIMEZONE="Asia/Kolkata"
# BIOMETRIC_SERVER_ADDRESS="yourapp.example.com"
# BIOMETRIC_SERVER_PORT="443"
